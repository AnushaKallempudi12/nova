# Supabase Auth project settings
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Supabase PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
NOVA_ALLOWED_ORIGINS=http://localhost:5173
# Optional public ATS board identifiers
GREENHOUSE_BOARD_TOKENS=coinbase
LEVER_SITE_NAMES=
ASHBY_BOARD_NAMES=
SMARTRECRUITERS_COMPANIES=
# Optional Google Programmable Search Engine for wider official career-site discovery and company research
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
# Gemini is the default AI provider when GEMINI_API_KEY is configured (never commit a real key)
GEMINI_API_KEY=
NOVA_AI_PROVIDER=gemini
# Optional Gemini model override; default is gemini-2.5-flash
NOVA_GEMINI_MODEL=gemini-2.5-flash
# Optional OpenAI fallback/provider
NOVA_OPENAI_API_KEY=
NOVA_COVER_LETTER_MODEL=gpt-4.1-mini
NOVA_OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# Optional JSON object, e.g. {"Example Corp":{"domain":"example.com","url":"https://careers.example.com"}}
NOVA_CAREER_SITES={}
